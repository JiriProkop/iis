{% extends 'base.html.twig' %}

{% block title %}Add People to Class{% endblock %}

{% block body %}
    {% if guarantors is not null %}
        <h2>Guarantor:</h2>
        {% if class.guarantor is not null %}
            {{ class.guarantor.login }} - <a href="/class/{{ class.id }}/remove_guarantor/">REMOVE</a>
        {% endif %}
        <ul>
            {% for g in guarantors %}
                <li>{{ g.login }} - <a href="/class/{{ class.id }}/set_guarantor/{{ g.id }}">SET GUARANTOR</a></li>
            {% endfor %}
        </ul>
    {% endif %}

    <h2>Vyucujici:</h2>
    <ul>
        {% for at in assigned_teachers %}
            <li>{{ at.login }} - <a href="/class/{{ class.id }}/remove_teacher/{{ at.id }}">REMOVE</a></li>
        {% endfor %}
    </ul>
    <h3>Pridat vyucujiciho:</h3>
    <ul>
        {% for t in teachers %}
            <li>{{ t.login }} - <a href="/class/{{ class.id }}/add_teacher/{{ t.id }}">ADD</a></li>
        {% endfor %}
    </ul>

    <a href="/class">DONE</a>
{% endblock %}
