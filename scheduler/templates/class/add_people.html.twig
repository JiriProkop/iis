{% extends 'base.html.twig' %}

{% block title %}Create Class{% endblock %}

{% block body %}
    {% if guarantors is not null %}
        <h2>Garant:</h2>
        {% if class.guarantor is not null %}
            <h3>{{ class.guarantor.login }} - <a href="/class/{{ class.id }}/remove_guarantor/">REMOVE</a></h3>
        {% endif %}
        <ul>
            {% for g in guarantors %}
                <li>{{ g.login }} - <a href="/class/{{ class.id }}/set_guarantor/{{ g.id }}">SET GUARANTOR</a></li>
            {% endfor %}
        </ul>
    {% endif %}
        <h2>Vyucujici:</h2>
        <ul>
            {% for t in class.people %}
                <li>{{ t.login }} - <a href="/class/{{ class.id }}/remove_teacher/{{ t.id }}">REMOVE</a></li>
            {% endfor %}
        </ul>
        <h3>Pridat vyucujiciho:</h3>
        <ul>
            {% for t in teachers %}
                <li>{{ t.login }} - <a href="/class/{{ class.id }}/add_teacher/{{ t.id }}">ADD</a></li>
            {% endfor %}
        </ul>

    <a href="/class/admin">DONE</a>
{% endblock %}
