{% extends 'base.html.twig' %}

{% block title %}Classes{% endblock %}

{% block body %}
    {% if role == 'ROLE_ADMIN' %}
        <a href="/class/create">Create class</a>
    {% endif %}
    {% if role == 'ROLE_STUDENT' %}
        {% if credits is not null %}<b>Credits registered:</b> {{ credits }}{% endif %}
        <ul>
            {% for r in registered %}
                <li>{{ r.name }} <a href="/class/{{ r.id }}/unregister">UNREGISTER</a></li>
            {% endfor %}
        </ul>
    {% endif %}
    <ul>
        {% for class in classes %}
            <li>
                <b>{{ class.abbreviation }}</b> - {{ class.name }} - <b>Credits:</b> {{ class.credits }}
                {% if role == 'ROLE_ADMIN' %}
                    <a href="/class/{{ class.id }}/edit">EDIT</a> -
                    <a href="/class/{{ class.id }}/delete">DELETE</a> -
                    <a href="/class/{{ class.id }}/add_people">ADD PEOPLE</a> -
                {% endif %}
                    <a href="/class/{{ class.id }}/detail">DETAIL</a>
                {% if role == 'ROLE_STUDENT' %}
                    <a href="/class/{{ class.id }}/register">REGISTER</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endblock %}
