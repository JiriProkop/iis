<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Scheduler{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
      
        {% block stylesheets %}
        <!-- Include additional stylesheets if needed -->
        {% endblock %}

        {% block javascripts %}
        <!-- Include JavaScript files if needed -->
        {% endblock %}

         {% block header %}
        <div style="background-color: #f2f2f2; padding: 10px;">
            {% if app.user %}
                <div class="user-banner">
                    Logged in as: {{ app.user.login }}  -- {{ app.user.email }}
                </div>
                <a href="/logout">LOG OUT</a>
                {% if 'ROLE_STUDENT' in app.user.roles or 'ROLE_TEACHER' in app.user.roles %}
                    <a href="/my_schedule/{{ app.user.id }}">MY SCHEDULE</a>
                {% endif %}
                {% if 'ROLE_STUDENT' in app.user.roles or 'ROLE_SCHEDULER' in app.user.roles %}
                    <a href="/make_schedule">CREATE SCHEDULE</a>
                {% endif %}
                {% if 'ROLE_ADMIN' in app.user.roles %}
                    <a href="/room/admin/list">ROOMS</a>
                {% endif %}
                {% if 'ROLE_ADMIN' in app.user.roles or 'ROLE_SCHEDULER' in app.user.roles %}
                    <a href="/person/list">TEACHER-SCHEDULES</a>
                {% endif %}
                {% if 'ROLE_TEACHER' in app.user.roles %}
                    <a href="/person/teacher/activity">TEACHER-ACTIVITIES</a>
                {% endif %}
            {% else %}
                <div class="user-banner">
                    You are viewing as a guest.
                    <a href="/login">LOG IN</a>
                </div>
            {% endif %}
        </div>
        {% endblock %}

        <!-- Include Interact.js from CDN -->
        <script src="https://cdn.jsdelivr.net/npm/interactjs@1.10.11/dist/interact.min.js"></script>
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
