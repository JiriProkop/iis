{% extends 'base.html.twig' %}

{% block title %}Personal Info{% endblock %}

{% block body %}
    {% if person is null %}
        Please login to view this page!
    {% else %}
        <h3>Login: {{ person.login }}</h3>
        <h4>Email: {{ person.email }}</h4>
        <a href="/person/edit">EDIT</a>
    {% endif %}
{% endblock %}
