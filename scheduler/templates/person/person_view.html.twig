{% extends 'base.html.twig' %}

{% block title %}Person Info{% endblock %}

{% block body %}
    {% if person is null %}
        Login to view this page!
    {% else %}
        <h4>Login: {{ person.login }}</h4>
        <h4>Email: {{ person.email }}</h4>
        <a href="/person/{{ person.id }}/edit">EDIT</a>
    {% endif %}
    {% if role == 'ROLE_ADMIN' %}
        <a href="/person/list">VIEW ALL PEOPLE</a>
    {% endif %}
{% endblock %}
