{% extends 'base.html.twig' %}

{% block title %}Edit Person{% endblock %}

{% block body %}
    {% if person is null %}
        Please login to view this page!
    {% else %}

    {% if error is not null %}
        {{ error }}
    {% endif %}

        {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">Edit</button>
        <p>Fields with * are mandatory.</p>
        {{ form_end(form) }}
    {% endif %}
{% endblock %}
