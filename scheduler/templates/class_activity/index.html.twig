{% extends 'base.html.twig' %}

{% block title %}Class Activities{% endblock %}

{% block body %}
    <a href="/class/{{ class.id }}/activities/create">Create activity</a>
    <ul>
        {% for activity in activities %}
            <li>
                {{ activity.id }} - {{ activity.name }} - {{ activity.repetition }} - {{ activity.length }}atd...
                <a href="/class/{{ class.id }}/activity/{{ activity.id }}/edit">EDIT</a> -
                <a href="/class/{{ class.id }}/activity/{{ activity.id }}/delete">DELETE</a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
