{% extends 'base.html.twig' %}

{% block title %}Class Activities{% endblock %}

{% block body %}
    {% if guarantees %}
        <a href="/class/{{ class.id }}/activity/create">Create activity</a>
    {% endif %}
    <ul>
        {% for activity in activities %}
            <li>
                <b>ID:</b> {{ activity.id }} <b>Name:</b> {{ activity.name }} <b>Repetition:</b> {{ activity.repetition }} <b>Length:</b> {{ activity.length }}
                {% if guarantees %}
                    <a href="/class/{{ class.id }}/activity/{{ activity.id }}/schedule">SCHEDULE</a> -
                    <a href="/class/{{ class.id }}/activity/{{ activity.id }}/edit">EDIT</a> -
                    <a href="/class/{{ class.id }}/activity/{{ activity.id }}/delete">DELETE</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endblock %}
