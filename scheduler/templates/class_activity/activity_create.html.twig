{% extends 'base.html.twig' %}

{% block title %}Create Activity{% endblock %}

{% block body %}
    {% if error is not null %}
        {{ error }}
    {% endif %}

    {%  if form is not null %}
        {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">Create</button>
        {{ form_end(form) }}
    {% endif %}
{% endblock %}
