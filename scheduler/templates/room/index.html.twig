{% extends 'base.html.twig' %}

{% block title %}Hello RoomController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>
<a href="/room/admin/create">Create person</a>
 <h1>Room List</h1>

    <ul>
        {% for room in res %}
            <li>
                {{ room.type }} (ID: {{ room.name }})
                <a href="/room/admin/edit{{ room.id }}">Edit room</a>

                <ul>
                    {% for activity in room.activities %}
                        <li>name: {{ activity.name }}</li>
                        <li>length: {{ activity.length }}</li>
                        <li>repetition: {{ activity.repetition }}</li>

                        <a href="/user/activity/detail/{{ activity.id }}">Activity detail</a>
                    {% endfor %}
                </ul>
            </li>
        {% endfor %}
    </ul>
{% endblock %}


