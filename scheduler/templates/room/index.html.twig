{% extends 'base.html.twig' %}

{% block title %}Hello RoomController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>
<a href="/room/admin/create">Create room</a>
 <h1>Room List</h1>

    <ul>
        {% for room in res %}
            <li>
                {{ room.type }} (ID: {{ room.name }})
                <a href="/room/admin/edit/{{ room.id }}">EDIT</a>
                <a href="/room/admin/delete/{{ room.id }}">DELETE</a>
                {% if room.activities is not empty %}    
                    <p style="font-weight: bold;">Activities:</p>
                    <ul>
                        {% for activity in room.activities %}
                            <li>name: {{ activity.name }}</li>

                            <a href="/user/activity/detail/{{ activity.id }}">detail</a>
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endblock %}


