{% extends 'base.html.twig' %}

{% block title %}Activities{% endblock %}

{% block body %}
<h1>List of activities</h1>
    <a href="/person/teacher/activity/create">Create personal activity</a>
<ul>
    {% for activity in activities %}
        <li>
            {{ activity.id }} - {{ activity.Description }} - {{ activity.Repetition }} - {{ activity.Length }} {% if activity.Room is not null %} - {{ activity.Room.Name}} {% endif %} - aktivita:
            <a href="/person/teacher/activity/delete/{{ activity.id }}">DELETE</a>
            <a href="/person/teacher/activity/edit/{{ activity.id }}">EDIT</a>
        </li>
        <ul>
            {% for window in windows[activity.id] %}
            <li><label>Start: </label>{{ window.Start.format('Y-m-d G:i:s') }}, <label>End: </label>{{ window.End.format('Y-m-d G:i:s') }}</li>
            {% endfor %}
        </ul>
    {% endfor %}
</ul>
{% endblock %}
